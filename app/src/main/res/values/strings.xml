    <string name="profile_label">Perfil de compactação</string>
    <string name="profile_fast">Rápido</string>
    <string name="profile_balanced">Equilibrado</string>
    <string name="profile_max">Máximo</string>
    <string name="profile_fast_hint">Prioriza a velocidade (codecs zlib/FLAC). Em geral várias vezes mais rápido, com arquivo um pouco maior.</string>
    <string name="profile_balanced_hint">Configuração padrão do chdman: resultado idêntico ao chdman oficial e máxima compatibilidade.</string>
    <string name="profile_max_hint">Prioriza o menor arquivo (hunks maiores com LZMA). Mais lento; lido por emuladores atuais baseados em libchdr. Se algum leitor antigo recusar, use Equilibrado.</string>
    <string name="profile_params">DVD: %1$s · CD: %2$s</string>

    <string name="cpu_economy">Econômico</string>
    <string name="cpu_balanced">Equilibrado</string>
    <string name="cpu_performance">Desempenho</string>
    <string name="cpu_economy_hint">Usa %2$d de %1$d núcleos e prioridade baixa: mais lento, com menos calor e consumo de bateria.</string>
    <string name="cpu_balanced_hint">Usa os %1$d núcleos com prioridade levemente reduzida, para a interface continuar fluida.</string>
    <string name="cpu_performance_hint">Usa os %1$d núcleos com prioridade normal. Em conversões longas o aparelho pode esquentar e reduzir a frequência.</string>

    <string name="advanced_show">Avançado ▸</string>
    <string name="advanced_hide">Avançado ▾</string>
    <string name="advanced_note">Hunks maiores reduzem o tamanho e aumentam o uso de RAM e o custo de cada leitura aleatória no emulador. Todos os valores são aceitos pelo chdman oficial. As threads não mudam durante uma operação.</string>
